# ============================================================================
# VeriTrace environment variables — ALL OPTIONAL. The app runs at $0 with none.
# ============================================================================

# Optional: a free-tier Groq API key enables the server-side LLM "style" rewrite
# pass for the sanitizer. If omitted, the deterministic local engine is used
# (default, instant, zero network). Users can also paste their OWN key at
# runtime (BYOK) without ever setting this.
#   Get a free key at: https://console.groq.com/keys
# GROQ_API_KEY=

# Optional: HMAC secret used to sign the stateless proof-of-work / rate-limit
# challenge tokens. If omitted a per-boot ephemeral secret is generated, which
# is fine for a single serverless instance.
# RATE_LIMIT_SECRET=

# Optional: override the default per-IP request budget (requests per minute).
# RATE_LIMIT_PER_MINUTE=15
